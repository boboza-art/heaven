# Haven Backend Environment Variables

# Database
DATABASE_URL=postgresql+psycopg2://haven:haven_dev@localhost:5432/haven

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# LLM Configuration
# Leave LLM_API_KEY empty to use mock AI service (no real LLM calls)
# Supports any OpenAI-compatible API: OpenAI, DeepSeek, Moonshot, etc.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_TO_MOCK=true
LLM_CONTEXT_WINDOW=10

# Memory System
# Extract memories from conversations automatically (requires LLM)
MEMORY_EXTRACTION_ENABLED=true
# Max approved memories to inject into AI context per conversation
MEMORY_MAX_IN_PROMPT=10
